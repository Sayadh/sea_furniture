# ───────── Server ─────────
NODE_ENV=production
PORT=4000
# VPS: 127.0.0.1 (Nginx in front). cPanel/Passenger hosting: leave EMPTY.
HOST=
# Number of trusted proxies in front of the API.
# Hosting (browser → Apache → Nuxt → Apache → API): 2.  VPS with Nginx: 1.
TRUST_PROXY=2
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://example.am,https://www.example.am
# Set to false to hide Swagger UI (/api/docs) in production
SWAGGER_ENABLED=false

# ───────── Database (MySQL / MariaDB) ─────────
# Local development: full URL (also used by the Prisma CLI in dev).
DATABASE_URL="mysql://sea:CHANGE_ME@localhost:3306/sea_furniture"
# Production (hosting): use DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD instead
# of DATABASE_URL — see .env.production.example.

# ───────── Auth (JWT in httpOnly cookies) ─────────
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_DIFFERENT
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# true in production (HTTPS). false only for local http development
COOKIE_SECURE=true
# Leave empty to scope cookies to the current host
COOKIE_DOMAIN=

# ───────── Images ─────────
# Folder for uploaded images (relative to the backend folder or absolute).
# Keep it OUTSIDE files you overwrite on deploy and include it in backups.
UPLOAD_DIR=uploads

# ───────── Seed (first admin user) ─────────
SEED_ADMIN_EMAIL=admin@example.am
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_ADMIN_NAME=Ադմինիստրատոր
# Set to true to reset the password of an existing admin on the next seed
SEED_ADMIN_RESET_PASSWORD=false
