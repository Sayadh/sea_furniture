# Build-time settings (read by `nuxt build` and baked into the build).
#   Local development: copy to frontend/.env
#   Production build:  copy to frontend/.env.production, then run: bash deploy/build-zips.sh

# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NUXT_PUBLIC_SITE_URL=https://seafurniture.am

# API origin (NestJS). The site proxies /api and /uploads to it.
#   Local: http://127.0.0.1:4000
VITE_API_URL=https://api.seafurniture.am
